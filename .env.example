# Optional. Full-loop smoke test (ignored by default):
#   cargo test --manifest-path src-tauri/Cargo.toml --test core_smoke -- --ignored --nocapture
# REBOST_ENGINE_ARCHIVE=/path/to/llama-b10621-bin-<host-archive>
# REBOST_TEST_MODEL=/path/to/small-chat.gguf

# Optional. Frontend lands on a view when running `pnpm tauri dev`.
# VITE_START_VIEW=chat
# VITE_START_SHELF=first

# Signed installers: copy these names into gitignored .env.signing.
# Values are not in this repository. Azure names are optional: empty means
# the Windows installer ships unsigned.
#   APPLE_SIGNING_IDENTITY=
#   APPLE_TEAM_ID=
#   APPLE_ID=
#   APPLE_PASSWORD=
#   AZURE_CLIENT_ID=
#   AZURE_CLIENT_SECRET=
#   AZURE_TENANT_ID=
#   AZURE_ARTIFACT_SIGNING_ENDPOINT=
#   AZURE_ARTIFACT_SIGNING_ACCOUNT=
#   AZURE_ARTIFACT_SIGNING_CERTIFICATE_PROFILE=
#   TAURI_SIGNING_PRIVATE_KEY=
#   TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
